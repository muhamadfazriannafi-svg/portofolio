# Salin file ini menjadi .env.local lalu isi nilainya.
# Tanpa env ini, situs tetap jalan memakai data contoh di src/lib/placeholder-data.ts.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Catatan untuk GitHub Pages:
# Kedua nilai di atas juga harus disimpan sebagai Repository Secrets
# (Settings > Secrets and variables > Actions) dengan nama yang sama,
# supaya build di GitHub Actions bisa mengambil data dari Supabase.
